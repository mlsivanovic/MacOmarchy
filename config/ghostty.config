# Ghostty. Ponovo učitaj: Cmd+Shift+,

# JetBrains Mono Nerd Font je već instaliran. Starship i eza ikone ostaju poravnate.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Prati svetli ili tamni izgled sistema.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

cursor-style = bar
cursor-style-blink = false

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
macos-titlebar-style = tabs

# Levi Option je Alt (reč unazad, Alt+Backspace). Desni Option ostaje za specijalne znakove.
macos-option-as-alt = left

copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = true
unfocused-split-opacity = 0.9

# F12 je bio iTerm hotkey prozor. Otvara se na monitoru ispod kursora.
keybind = global:f12=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.1
quick-terminal-space-behavior = move
