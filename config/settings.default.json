{
  "ui": {
    "alerts": true,
    "alertDuration": 2
  },
  "shortcuts": {
    "layout_next": "ctrl+alt+l",
    "layout_previous": "ctrl+alt+shift+l",
    "layout_tall": "ctrl+alt+a",
    "layout_wide": "ctrl+alt+w",
    "layout_single": "ctrl+alt+f",
    "layout_floating": "ctrl+alt+shift+f",
    "layout_show": "ctrl+alt+i",
    "layout_reflow": "ctrl+alt+r",
    "window_toggle_floating": "ctrl+alt+t",
    "tiling_toggle": "ctrl+alt+shift+t",
    "window_swap_previous": "ctrl+alt+shift+left",
    "window_swap_next": "ctrl+alt+shift+right",
    "window_previous_monitor": "ctrl+alt+shift+up",
    "window_next_monitor": "ctrl+alt+shift+down",
    "window_swap_main": "ctrl+alt+m",
    "tiler_shrink_main": "ctrl+alt+-",
    "tiler_expand_main": "ctrl+alt+=",
    "focus_left": "ctrl+alt+left",
    "focus_right": "ctrl+alt+right",
    "focus_up": "ctrl+alt+up",
    "focus_down": "ctrl+alt+down",
    "focus_toggle": "ctrl+alt+p",
    "launch_ghostty": "cmd+return",
    "launch_finder": "cmd+e",
    "launch_browser": "cmd+shift+return",
    "app_exclude": "ctrl+alt+x",
    "desktop_1": "cmd+1",
    "desktop_2": "cmd+2",
    "desktop_3": "cmd+3",
    "desktop_4": "cmd+4",
    "desktop_5": "cmd+5",
    "desktop_6": "cmd+6",
    "desktop_7": "cmd+7",
    "desktop_8": "cmd+8",
    "desktop_9": "cmd+9",
    "window_move_1": "cmd+shift+1",
    "window_move_2": "cmd+shift+2",
    "window_move_3": "cmd+shift+3",
    "window_move_4": "cmd+shift+4",
    "window_move_5": "cmd+shift+5",
    "window_move_6": "cmd+shift+6",
    "window_move_7": "cmd+shift+7",
    "window_move_8": "cmd+shift+8",
    "window_move_9": "cmd+shift+9",
    "menu_commands": "ctrl+alt+space",
    "menu_commands_alt": "ctrl+alt+k",
    "settings_open": "ctrl+alt+,",
    "clipboard_history": "ctrl+v"
  },
  "tiler": {
    "enabled": true,
    "gap": 4,
    "margin": 4,
    "tolerance": 2,
    "newWindowPosition": "end",
    "layout": "tall",
    "ratio": 0.5,
    "ratioMin": 0.2,
    "ratioMax": 0.8,
    "resizeStep": 0.05,
    "debounce": 0.04,
    "maxAttempts": 2,
    "fallbackScan": 5,
    "layouts": [
      "tall",
      "wide",
      "fullscreen",
      "floating"
    ]
  },
  "desktops": {
    "settleDelay": 0.15,
    "scrollLock": 1,
    "transitionTimeout": 2,
    "creationTimeout": 3,
    "pollInterval": 0.04,
    "checkInterval": 0.1,
    "focusDelay": 0.15,
    "maxNumber": 9
  },
  "focus": {
    "enabled": false,
    "delay": 0.1,
    "slop": 8,
    "clickTextFields": true,
    "fieldRetryDelay": 0.12
  },
  "clipboard": {
    "maxItems": 100,
    "maxImageMB": 32,
    "storeImages": true,
    "previewSize": 72,
    "pollInterval": 0.4,
    "saveDelay": 0.5,
    "chooserRows": 9,
    "pasteDelay": 0.12
  }
}
